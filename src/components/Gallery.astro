---
interface Props { images: string[]; }
const { images } = Astro.props;
---

<div class="gallery" data-gallery>
  {images.map((src, index) => (
    <a href={src} aria-label={`Otevřít fotografii ordinace ${index + 1} z ${images.length}`} data-gallery-thumb>
      <img src={src} alt={`Fotografie ordinace ${index + 1}`} loading="lazy" />
    </a>
  ))}
  <dialog class="lightbox" aria-label="Galerie fotografií ordinace">
    <div class="lightbox-content">
      <button type="button" class="lightbox-close" aria-label="Zavřít galerii" data-gallery-close>×</button>
      <figure><img src="" alt="" data-gallery-image /><figcaption aria-live="polite" data-gallery-caption></figcaption></figure>
      <div class="lightbox-controls">
        <button type="button" aria-label="Předchozí fotografie" data-gallery-prev>←</button>
        <button type="button" aria-label="Další fotografie" data-gallery-next>→</button>
      </div>
    </div>
  </dialog>
</div>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const thumbs = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-gallery-thumb]')];
    const dialog = gallery.querySelector<HTMLDialogElement>('dialog');
    const image = gallery.querySelector<HTMLImageElement>('[data-gallery-image]');
    const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]');
    const close = gallery.querySelector<HTMLButtonElement>('[data-gallery-close]');
    const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    if (!dialog || !image || !caption || !close || !prev || !next || !thumbs.length) continue;

    let current = 0;
    let opener: HTMLAnchorElement | null = null;
    const show = (index: number) => {
      current = (index + thumbs.length) % thumbs.length;
      image.src = thumbs[current].href;
      image.alt = `Fotografie ordinace ${current + 1} z ${thumbs.length}`;
      caption.textContent = `${current + 1} / ${thumbs.length}`;
    };

    thumbs.forEach((thumb, index) => thumb.addEventListener('click', (event) => {
      event.preventDefault();
      opener = thumb;
      show(index);
      dialog.showModal();
      close.focus();
    }));
    close.addEventListener('click', () => dialog.close());
    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
      if (event.key === 'Escape') { event.preventDefault(); dialog.close(); }
    });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { image.removeAttribute('src'); opener?.focus(); });
  }
</script>

<style>
  .gallery a{display:block;line-height:0;outline-offset:3px}
  .lightbox{position:fixed;inset:0;max-width:min(96vw,1100px);max-height:96vh;width:max-content;border:0;border-radius:6px;padding:0;background:#14242c;color:#fff;box-shadow:0 20px 70px #0009}
  .lightbox::backdrop{background:#06131bdc}
  .lightbox-content{position:relative;padding:3rem 1rem .8rem;text-align:center}
  .lightbox figure{margin:0}
  .lightbox figure img{display:block;max-width:calc(96vw - 2rem);max-height:calc(96vh - 8rem);width:auto;height:auto;margin:auto;object-fit:contain}
  .lightbox figcaption{font-size:.9rem;margin-top:.4rem}
  .lightbox button{cursor:pointer;border:1px solid #b9d5dd;background:#24495a;color:#fff;border-radius:4px;min-width:2.7rem;min-height:2.7rem;font-size:1.4rem}
  .lightbox button:hover,.lightbox button:focus-visible{background:#386c80}
  .lightbox-close{position:absolute;right:.8rem;top:.55rem}
  .lightbox-controls{display:flex;justify-content:center;gap:1rem;margin-top:.4rem}
</style>
