---
import Layout from '../layouts/Layout.astro';
import Hours from '../components/Hours.astro';
import obsah from '../content/data/obsah.json';
---

<Layout title="O nás" current="/">
  <h1>O nás</h1>
  <div class="intro">
    <img src="/images/uvod.jpg" alt="Ilustrační fotografie" width="229" height="313" />
    {obsah.uvod.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <section>
    <h2>ON-LINE služby</h2>
    <p>{obsah.onlineUvod}</p>
    <p>{obsah.onlinePokyn}</p>
    <a class="smartmedix" href={obsah.smartmedixUrl} target="_blank" rel="noopener noreferrer" aria-label="SmartMEDIX.net"><img src="/images/smartmedix.jpg" alt="SmartMEDIX.net" /></a>
    <h3>Po přihlášení máte k dispozici tyto služby</h3>
    <ul>{obsah.onlineSluzby.map((item) => <li>{item}</li>)}</ul>
    <ul>{obsah.onlineRegistrace.map((item) => <li>{item}</li>)}</ul>
    <p><strong>{obsah.nezrusenaObjednavka}</strong></p>
  </section>
  <Hours />
</Layout>
